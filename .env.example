# Transport Mode: "stdio" or "streamable-http"
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Bearer Token for HTTP mode (not required for stdio)
MCP_AUTH_TOKEN=dev-secret-token-change-in-production

# Environment: "development", "test", or "production"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Resource Caps & Guardrails
MAX_ROWS=100
MAX_PAYLOAD_BYTES=65536
QUERY_TIMEOUT_SECONDS=2.0
MAX_AGENT_FILE_BYTES=1048576
REDACT_PII=true
